#compdef git-loom
# git-loom managed completion v1

_git_loom_register() {
  (( $+functions[compdef] )) || return 0
  compdef _git-loom git-loom
  local -a existing
  zstyle -a ':completion:*:*:git:*' user-commands existing
  if (( ! ${existing[(I)loom:*]} )); then
    zstyle ':completion:*:*:git:*' user-commands "${existing[@]}" 'loom:Manage Git work environments'
  fi
}

_git-loom() {
  local -a loom_words global_args candidates commands
  local loom_current=$CURRENT i=2 sub='' action='' kind=refs
  loom_words=("${words[@]}")
  if [[ ${loom_words[1]} == git ]]; then
    loom_words=(git-loom "${loom_words[@]:2}")
    (( loom_current-- ))
  fi
  commands=(@LOOM_COMMANDS@)
  while (( i < loom_current )); do
    case ${loom_words[i]} in
      --repo|--config)
        if (( i+1 < loom_current )); then global_args+=("${loom_words[i]}" "${loom_words[i+1]}"); fi
        (( i += 2 ));;
      --repo=*|--config=*) global_args+=("${loom_words[i]}"); (( i++ ));;
      --dry-run) (( i++ ));;
      *) sub=${loom_words[i]}; break;;
    esac
  done
  if [[ ${loom_words[loom_current-1]} == --repo ]]; then
    candidates=("${(@f)$(git-loom "${global_args[@]}" __complete repos 2>/dev/null)}")
    _describe 'repositories' candidates; return
  fi
  if [[ ${loom_words[loom_current-1]} == --config ]]; then _files; return; fi
  if [[ -z $sub ]]; then
    _describe 'commands' commands
    compadd -- @LOOM_FLAGS@
    return
  fi
  case $sub in
    config|uninstall) return;;
    doctor) compadd -- @DOCTOR_FLAGS@; return;;
    completions)
      if [[ ${loom_words[loom_current-1]} == --dir ]]; then _files -/; else compadd -- zsh @COMPLETION_FLAGS@; fi
      return;;
    worktree)
      action=${loom_words[i+1]}
      if (( loom_current == i+1 )); then compadd -- @WORKTREE_COMMANDS@; return; fi
      if [[ $action == remove ]]; then kind=worktrees; compadd -- @WORKTREE_REMOVE_FLAGS@
      elif [[ $action == add ]]; then compadd -- @WORKTREE_ADD_FLAGS@; _files -/
      else return; fi;;
  esac
  if (( ${loom_words[(I)--]} > i )); then _files; return; fi
  candidates=("${(@f)$(git-loom "${global_args[@]}" __complete "$kind" 2>/dev/null)}")
  compadd -a candidates
  _files
  # Use system Git completion for native options; the candidates above provide Loom references.
  if [[ ${loom_words[loom_current]} == -* && $sub != worktree ]]; then
    local -a words=(git "${loom_words[@]:$((i-1))}")
    local CURRENT=$((loom_current-i+2))
    _git
  fi
}

# Dispatch on the first autoload invocation; only define functions when loaded via eval.
if [[ $ZSH_EVAL_CONTEXT == *shfunc* ]]; then
  _git-loom "$@"
fi
